# Example region-specific env for systemd EnvironmentFile=.env.caribbean
# and local: ./scripts/start_server.sh caribbean
#
# Env loading contract: see .env.example and docs/development.md

REGION=caribbean
DATA_DIR=./data/caribbean
LISTEN=:8082
PUBLIC_SITE_URL=https://caribbean.ipv6forum.com

PROBE_V4_URL=https://ipv4.caribbean.ipv6forum.com/api/healthz
PROBE_V6_URL=https://ipv6.caribbean.ipv6forum.com/api/healthz
PROBE_DS_URL=https://caribbean.ipv6forum.com/api/healthz
HEALTHZ_CORS_ALLOW_ORIGIN=https://caribbean.ipv6forum.com,https://127.0.0.1:8082,https://localhost:8082

RIPESTAT_SOURCEAPP=caribbean-ipv6-monitor
IPV4_OUTAGE_HOST=caribbean.ipv6forum.com
# Skip 6/6 drill until publicly announced for this hostname
IPV4_OUTAGE_SKIP=1

# Prefer skip RPKI until sourceapp is registered with RIPEstat
COLLECTOR_SKIP_RPKI=1
# Optional: stagger vs pacific collector
# COLLECTOR_PER_COUNTRY_INTERVAL=4h
