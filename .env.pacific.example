# Example region-specific env for systemd EnvironmentFile=.env.pacific
# and local: ./scripts/start_server.sh pacific
#
# Env loading contract:
# - systemd EnvironmentFile=.env.%i is authoritative for region keys
# - godotenv only fills unset keys from .env / .env.local (never opens .env.pacific)
# - Do NOT put DATA_DIR, LISTEN, PUBLIC_SITE_URL, PROBE_*, REGION, TLS_* in a shared .env

REGION=pacific
DATA_DIR=./data/pacific
LISTEN=:8082
PUBLIC_SITE_URL=https://pacific.ipv6forum.com

# Per-region TLS for the Go HTTPS listener (see certs/README.md). Prod public
# certs at nginx usually live under the same tree, e.g. fullchain.pem / key.pem.
TLS_CERT_FILE=certs/pacific/cert.pem
TLS_KEY_FILE=certs/pacific/key.pem

PROBE_V4_URL=https://ipv4.pacific.ipv6forum.com/api/healthz
PROBE_V6_URL=https://ipv6.pacific.ipv6forum.com/api/healthz
PROBE_DS_URL=https://pacific.ipv6forum.com/api/healthz
HEALTHZ_CORS_ALLOW_ORIGIN=https://pacific.ipv6forum.com,https://127.0.0.1:8082,https://localhost:8082

RIPESTAT_SOURCEAPP=pacific-ipv6-monitor
IPV4_OUTAGE_HOST=pacific.ipv6forum.com
# IPV4_OUTAGE_SKIP=1
